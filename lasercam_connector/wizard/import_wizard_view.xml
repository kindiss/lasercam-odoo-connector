<?xml version="1.0" encoding="utf-8"?>
  <data>

    <!-- Export wizard form: a single Download button. -->
    <record id="view_lasercam_export_wizard" model="ir.ui.view">
      <field name="name">lasercam.export.wizard.form</field>
      <field name="model">lasercam.export.wizard</field>
      <field name="arch" type="xml">
        <form string="Export to LaserCAM">
          <div style="margin: 6px 4px 12px; font-size: 14px; line-height: 1.5;">
            Download the ZIP file and drop it (drag &amp; drop) into
            <a href="https://laser.ucase.eu/app" target="_blank">laser.ucase.eu/app</a>.
            The app will unpack the BOM and work center data itself.
          </div>
          <group>
            <field name="is_template"/>
          </group>
          <div style="margin: -4px 4px 12px; color: #666; font-size: 12px; line-height: 1.4;">
            Ticked: the product opens in LaserCAM as a disabled <b>template</b> for new products.
            Unticked: it opens active and its own BOM is recalculated.
          </div>
          <footer>
            <button name="action_download" string="Download ZIP" type="object" class="btn-primary"/>
            <button name="action_done" string="Done" type="object" class="btn-default"/>
          </footer>
        </form>
      </field>
    </record>

    <!-- Import wizard form: two files + result. -->
    <record id="view_lasercam_import_wizard" model="ir.ui.view">
      <field name="name">lasercam.import.wizard.form</field>
      <field name="model">lasercam.import.wizard</field>
      <field name="arch" type="xml">
        <form string="Import from LaserCAM">
          <group string="LaserCAM fixes (ZIP)">
            <field name="zip_file" filename="zip_filename"/>
            <field name="zip_filename" invisible="1"/>
          </group>
          <group string="Or individual CSV files (if the ZIP is already unpacked)">
            <field name="bom_file" filename="bom_filename"/>
            <field name="bom_filename" invisible="1"/>
            <field name="wc_file" filename="wc_filename"/>
            <field name="wc_filename" invisible="1"/>
            <field name="create_file" filename="create_filename"/>
            <field name="create_filename" invisible="1"/>
          </group>
          <group>
            <field name="result"/>
          </group>
          <footer>
            <button name="action_import" string="Import" type="object" class="btn-primary"/>
            <button name="action_done" string="Close" type="object" class="btn-default"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
