<?xml version="1.0" encoding="utf-8"?>
<!-- <data> root — accepted in all Odoo v9-19 (unlike <openerp>/<odoo>).
     ONE "LaserCAM" action opens the hub wizard (Send directly / Download ZIP /
     Import). Bound to the mrp.bom Action menu in the Python post_init_hook
     (__init__.py), since XML cannot unify ir.values (v9-11) / binding_model_id (v12+). -->
<data>

  <record id="action_lasercam_import" model="ir.actions.act_window">
    <field name="name">LaserCAM</field>
    <field name="res_model">lasercam.import.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- 5.3: limit the LaserCAM action(s) to the LaserCAM group. Done in Python because the
       field is groups_id on Odoo 9-18 and group_ids on Odoo 19; <function> also runs on upgrade. -->
  <function model="lasercam.import.wizard" name="_lasercam_set_action_groups"/>

</data>
